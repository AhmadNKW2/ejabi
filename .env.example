# Copy to apps/api/.env and adjust as needed.
#
# Local Docker Postgres (optional):
#   docker compose up -d
#   DATABASE_URL=postgresql://ejabi:ejabi@127.0.0.1:5433/ejabi
#   DIRECT_URL=postgresql://ejabi:ejabi@127.0.0.1:5433/ejabi
#
# Neon (recommended): use the pooled host for DATABASE_URL and the
# non-pooler host for DIRECT_URL (Prisma migrations).

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ADMIN_EMAIL=admin@ejabi.local
ADMIN_PASSWORD=Admin123!

PORT=3001
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
COOKIE_SECURE=false
